# NCScope v1.4 runtime
# Copy this file to `.env` for local development.

# FastAPI imports do not auto-load `.env` by default.
# Use `.\run_local.ps1`, export variables in the shell, or set this true only for
# trusted single-process local development.
NCSCOPE_LOAD_DOTENV=false

# Required: read-only NCS_MCP endpoint backed by the compact serving DB.
NCS_MCP_URL=http://127.0.0.1:8778/mcp
NCS_MCP_TIMEOUT_SEC=45
NCS_MCP_DETAIL_CONCURRENCY=4

# Optional: used by START_NCSCOPE.bat / run_local.ps1 to auto-start the local
# NCS DB search server when NCS_MCP_URL points to localhost and the port is not
# already open.
NCSCOPE_AUTO_START_NCS_MCP=true
NCS_MCP_REPO=C:\workspace\NCS_MCP
NCS_DB_PATH=C:\workspace\NCS_MCP\data\processed\ncs.db

# Public question generation uses a request-scoped OpenAI key supplied by the
# user. NCScope does not read OPENAI_API_KEY, persist the key, or fall back to
# another provider when the request key is missing or a call fails.
INTERVIEW_GENERATION_PROVIDER=openai_api
# The UI must not persist an optional request key in browser storage, files, or DB.
# Except for loopback-only development, expose NCScope only through HTTPS and
# disable request-body capture in proxies, APM, tracing, and error reporting.
#
# OpenAI credentials are pinned to https://api.openai.com/v1. OPENAI_BASE_URL
# overrides are intentionally ignored in public-institution mode.
# Quality-first interview generation. The strategy/UI path and the auxiliary
# question APIs use explicit model settings so changing a vision/rerank model
# cannot silently lower interview-question quality.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_RERANK_MODEL=gpt-5.6-luna
OPENAI_STRATEGY_MODEL=gpt-5.6-terra
OPENAI_STRATEGY_RETRY_MODEL=gpt-5.6-sol
OPENAI_QUESTION_MODEL=gpt-5.6-terra
OPENAI_QUALITY_REGENERATION_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_STRATEGY_REASONING_EFFORT=high
OPENAI_QUESTION_REASONING_EFFORT=high
OPENAI_QUALITY_REVIEW_REASONING_EFFORT=high
OPENAI_QUALITY_REVIEW_MODEL=gpt-5.6-sol
OPENAI_STRATEGY_CANDIDATE_MULTIPLIER=1
OPENAI_QUESTION_CANDIDATE_MULTIPLIER=1
OPENAI_QUESTION_VARIANT_ATTEMPTS=1
OPENAI_STRATEGY_TIMEOUT_SEC=120
ENABLE_AI_RERANK=true
OPENAI_NET_CHECK_ENABLED=true
OPENAI_NET_CHECK_STRICT=false
OPENAI_NET_CHECK_CONNECT_TIMEOUT_SEC=5
OPENAI_NET_CHECK_READ_TIMEOUT_SEC=15
OPENAI_HTTP_CURL_FALLBACK_ENABLED=false

AI_QUALITY_REVIEW_TIMEOUT_SEC=70

# Upload and parser behavior.
MAX_UPLOAD_MB=30
MAX_REQUEST_BODY_MB=62
DOCUMENT_PARSE_REQUEST_BUDGET_SEC=285
# Required in stateless/serverless deployments; use a random 32-byte-or-longer secret.
REVIEW_SESSION_SIGNING_KEY=SET_RANDOM_REVIEW_SESSION_SIGNING_KEY
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_REQUESTS_PER_WINDOW=120
GENERATION_RATE_LIMIT_REQUESTS_PER_WINDOW=30
GENERATION_MAX_CONCURRENCY=8
KORDOC_OCR=true
PDF_SCLASS_MAX_PAGES=24
# Optional review-only profile produced by scripts/collect_alio_documents.py.
# Defaults to .local/alio_corpus/sclass_profiles.json when omitted.
# ALIO_SCLASS_PROFILE_PATH=C:\workspace\NCScope\.local\alio_corpus\sclass_profiles.json

# Small local app DB. This is not the NCS serving DB.
DATABASE_URL=sqlite:///./ncscope.db

# Keep public/admin/legacy maintenance surfaces disabled for the MVP.
ENABLE_ADMIN_ENDPOINTS=false
ADMIN_TOKEN=SET_STRONG_ADMIN_TOKEN
ENABLE_LEGACY_NCS_API=false
AUTO_SYNC_PUBLIC_INST=false
AUTO_SYNC_NCS=false

# Legacy public-data integrations are not used by the default NCScope MVP path.
# Enable only for private maintenance deployments that intentionally reactivate
# legacy endpoints.
# PUBLIC_INST_SERVICE_KEY=YOUR_PUBLIC_INST_KEY
# NCS_SERVICE_KEY=YOUR_NCS_KEY
# PUBLIC_INST_BASE_URL=https://apis.data.go.kr/1051000/public_inst/
# NCS_BASE_URL=https://www.ncs.go.kr/api/
# NCS_BASE_URLS=https://www.ncs.go.kr/api/
